# HostelSwap Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# Supabase (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # service_role key, NOT anon key

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-random-secret-here
JWT_EXPIRY_HOURS=168

# AI / LLM — set provider to "gemini" or "groq"
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIza...   # from aistudio.google.com
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=            # from console.groq.com (optional)
GROQ_MODEL=llama-3.3-70b-versatile

# RAG
HOSTEL_POLICY_PDF=./docs/hostel_policy.pdf
CHROMA_DB_PATH=./chroma_db

# Firebase (optional — push notifications)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
